# Copy to .env — required by apps/api

# Prisma / PostgreSQL
DATABASE_URL="postgresql://marketplace:marketplace_dev@localhost:5433/marketplace_db"

# Server
API_PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=replace-with-32+-char-random-string
JWT_REFRESH_SECRET=replace-with-different-32+-char-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
